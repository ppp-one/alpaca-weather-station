constexpr int RAIN_SENSOR_SAFE_PIN = A7;
constexpr int RAIN_SENSOR_SIGNAL_HIGH_PIN = A6;

// RS485 timing calculations
constexpr auto bitduration = 1.0f / BAUDRATE;
constexpr auto wordlen = 9.6f;
constexpr auto preDelayBR = static_cast<int>(bitduration * wordlen * 3.5f * 1e6);
constexpr auto postDelayBR = static_cast<int>(bitduration * wordlen * 3.5f * 1e6);

// Network configuration
byte mac[6];
const byte ip[] = {192, 168, 1, 12};
constexpr int SERVER_PORT = 80;

// Global variables
WeatherLimits currentLimits;
const char limitsKey[] = "limits";

// Thread management
static Thread SensorReadThread;
static Thread NetworkThread;

// Thread synchronization
static Mutex s700DataMutex;
static Mutex safetyStateMutex;
static Mutex errorStateMutex;
static Mutex limitsConfigMutex;

// S700 weather station data (protected by mutex)
float s700Values[16] = {0};
volatile bool isSafe = false;
volatile bool rainSensorSafe = true;

// Alpaca error handling (protected by mutex)
int32_t ErrorNumber = 0;
String ErrorMessage = "\"\"";

// Network objects
EthernetServer server(SERVER_PORT);
Application app;
// S700 sensor data mapping
const std::unordered_map<std::string, int> s700Key = {
    {"AT", 0},   // Air temperature (°C)
    {"AH", 1},   // Air humidity (%RH)
    {"AP", 2},   // Barometric pressure (Pa)
    {"LX", 3},   // Light intensity (Lux)
    {"DN", 4},   // Minimum wind direction (deg)
    {"Dm", 5},   // Maximum wind direction (deg)
    {"DA", 6},   // Average wind direction (deg)
    {"SN", 7},   // Minimum wind speed (m/s)
    {"SM", 8},   // Maximum wind speed (m/s)
    {"SA", 9},   // Average wind speed (m/s)
    {"RA", 10},  // Accumulated rainfall (mm)
    {"RD", 11},  // Duration of rainfall (s)
    {"RI", 12},  // Rainfall intensity (mm/h)
    {"Rp", 13},  // Maximum rainfall intensity (mm/h)
    {"HT", 14},  // Heating temperature (°C)
    {"TILT", 15} // Fall detection
};

// Utility function to split strings
String split(String data, char separator, int index)
{
    int found = 0;
    int strIndex[] = {0, -1};
    int maxIndex = data.length() - 1;

    for (int i = 0; i <= maxIndex && found <= index; i++)
    {
        if (data.charAt(i) == separator || i == maxIndex)
        {
            found++;
            strIndex[0] = strIndex[1] + 1;
            strIndex[1] = (i == maxIndex) ? i + 1 : i;
        }
    }

    return found > index ? data.substring(strIndex[0], strIndex[1]) : "";
}

// Main sensor reading thread - runs continuously
void readSensors()
{
    auto time_since_not_safe = Kernel::Clock::now();
    bool weather_station_data_received = false;
    bool safety_check_passed = false;

    while (true)
    {
        digitalWrite(LED_BUILTIN, HIGH);

        // Read weather station data
        weather_station_data_received = readWeatherStation();

        // Perform safety check
        safety_check_passed = safetyCheck();

        // Update safety status with proper synchronization
        {
            std::lock_guard<Mutex> lock(safetyStateMutex);
            bool current_safe = weather_station_data_received && safety_check_passed && rainSensorSafe;

            if (!current_safe)
            {
                time_since_not_safe = Kernel::Clock::now();
                isSafe = false;
            }
            else
            {
                // Only set safe if enough time has passed since last unsafe condition
                auto time_since_unsafe = Kernel::Clock::now() - time_since_not_safe;
                WeatherLimits limits;
                {
                    std::lock_guard<Mutex> limitsLock(limitsConfigMutex);
                    limits = currentLimits;
                }

                if (time_since_unsafe > std::chrono::seconds(limits.safety_false_duration))
                {
                    isSafe = true;
                }
            }

            // Update status LED
            digitalWrite(STATUS_LED_PIN, !isSafe);
        }

        // Handle errors with synchronization
        {
            std::lock_guard<Mutex> errorLock(errorStateMutex);
            if (!weather_station_data_received)
            {
                ErrorNumber = 1;
                ErrorMessage = "\"No data received from weather station\"";
            }
            else
            {
                ErrorNumber = 0;
                ErrorMessage = "\"\"";
            }
        }

        // LED blink pattern and delay
        ThisThread::sleep_for(SENSOR_READ_INTERVAL_MS);
        digitalWrite(LED_BUILTIN, LOW);
        ThisThread::sleep_for(SENSOR_READ_INTERVAL_MS);
    }
}

// Read data from the S700 weather station via RS485
bool readWeatherStation()
{
    const unsigned long timeout = 500; // 500 ms timeout
    const int maxChars = 256;
    char buffer[maxChars + 1];
    int charCount = 0;
    auto startTime = rtos::Kernel::Clock::now();

    // For development/testing - uncomment to use real RS485 communication
    /*
    RS485.noReceive();
    RS485.beginTransmission();
    RS485.println("0XA;G0?");
    RS485.flush();
    RS485.endTransmission();
    RS485.receive();

    while (rtos::Kernel::Clock::now() - startTime < std::chrono::milliseconds(timeout)) {
      if (RS485.available()) {
        char c = RS485.read();
        buffer[charCount++] = c;
        if (c == '\n') {
          break;
        }
      }
    }
    buffer[charCount] = '\0';
    String val = String(buffer);
    */

    // Simulated data for testing
    charCount = 16;
    String val = "0XA;AT=23.6;AH=56.4;AP=100819.1;LX=93.0;DN=0.0;DM=0.0;DA=0.0;SN=0.0;SM=0.0;SA=0.0;RA=1.4;RD=60.0;RI=0.0;RP=0.0;HT=-38.4;TILT=0\r\n";

    if (charCount == 0)
    {
        return false;
    }

    // Parse S700 response format
    if (val.startsWith("0XA;AT") && val.endsWith("TILT=0\r\n"))
    {
        return parseS700Data(val);
    }
    else
    {
        Serial.print("Invalid response received: ");
        Serial.println(val);
        return false;
    }
}

// Parse S700 weather station data string
bool parseS700Data(const String &data)
{
    int valueIndex = 0;
    int found = 0;
    int strIndex[] = {0, -1};
    int maxIndex = data.length() - 1;
    char separator = ';';

    // Temporary array to hold parsed values
    float tempValues[16] = {0};

    for (int i = 0; i <= maxIndex; i++)
    {
        if (data.charAt(i) == separator || i == maxIndex)
        {
            found++;
            strIndex[0] = strIndex[1] + 1;
            strIndex[1] = (i == maxIndex) ? i + 1 : i;
        }

        if (found == 2)
        {
            String valueString = data.substring(strIndex[0], strIndex[1]);
            found = 1;

            if (valueString.length() > 2 && valueIndex < 15)
            {
                tempValues[valueIndex] = valueString.substring(3).toFloat();
                valueIndex++;
            }
        }
    }

    // Update global array with thread safety
    if (valueIndex > 0)
    {
        std::lock_guard<Mutex> lock(s700DataMutex);
        memcpy(s700Values, tempValues, sizeof(s700Values));
        return true;
    }

    return false;
}

// Perform comprehensive safety check of all sensors
bool safetyCheck()
{
    bool safe = true;
    float sensorData[16];
    WeatherLimits limits;

    // Get thread-safe copies of data
    {
        std::lock_guard<Mutex> dataLock(s700DataMutex);
        memcpy(sensorData, s700Values, sizeof(s700Values));
    }
    {
        std::lock_guard<Mutex> limitsLock(limitsConfigMutex);
        limits = currentLimits;
    }

    // Check rain sensor
    if (analogRead(RAIN_SENSOR_SAFE_PIN) > RAIN_SENSOR_THRESHOLD)
    {
        Serial.println("Rain sensor active");
        rainSensorSafe = false;
        safe = false;
    }
    else
    {
        rainSensorSafe = true;
    }

    // Check temperature limits
    float temperature = sensorData[s700Key.at("AT")];
    if (temperature < limits.AT_min || temperature > limits.AT_max)
    {
        Serial.print("Temperature out of range: ");
        Serial.println(temperature);
        safe = false;
    }

    // Check humidity limits
    float humidity = sensorData[s700Key.at("AH")];
    if (humidity < limits.AH_min || humidity > limits.AH_max)
    {
        Serial.print("Humidity out of range: ");
        Serial.println(humidity);
        safe = false;
    }

    // Check light intensity
    float lightIntensity = sensorData[s700Key.at("LX")];
    if (lightIntensity > limits.LX_max)
    {
        Serial.print("Light intensity out of range: ");
        Serial.println(lightIntensity);
        safe = false;
    }

    // Check gust wind speed
    float gustWindSpeed = sensorData[s700Key.at("SM")];
    if (gustWindSpeed > limits.SM_max)
    {
        Serial.print("Gust wind speed out of range: ");
        Serial.println(gustWindSpeed);
        safe = false;
    }

    // Check average wind speed
    float avgWindSpeed = sensorData[s700Key.at("SA")];
    if (avgWindSpeed > limits.SA_max)
    {
        Serial.print("Average wind speed out of range: ");
        Serial.println(avgWindSpeed);
        safe = false;
    }

    // Check rainfall intensity (any rain is unsafe)
    float rainfallIntensity = sensorData[s700Key.at("RI")];
    if (rainfallIntensity > 0)
    {
        Serial.print("Rainfall detected: ");
        Serial.println(rainfallIntensity);
        safe = false;
    }

    // Check maximum rainfall intensity
    float maxRainfallIntensity = sensorData[s700Key.at("Rp")];
    if (maxRainfallIntensity > 0)
    {
        Serial.print("Maximum rainfall intensity detected: ");
        Serial.println(maxRainfallIntensity);
        safe = false;
    }

    return safe;
}

// Calculate dew point from temperature and humidity using Magnus formula
float calculateDewPoint(float temperature, float humidity)
{
    float B = (log(humidity / 100.0f) + ((17.27f * temperature) / (237.3f + temperature))) / 17.27f;
    return (237.3f * B) / (1.0f - B);
}

// Handle ASCOM Alpaca API endpoint requests
void endPoint(Request &req, Response &res)
{
    res.set("Content-Type", "application/json");
    String url = split(req.path(), '/', 5);

    // Parse query parameters
    uint32_t ClientID = 0;
    uint32_t ClientTransactionID = 0;
    uint32_t ServerID = 0;
    uint32_t ServerTransactionID = 0;

    char buffer[16];
    if (req.query("ClientID", buffer, sizeof(buffer)))
    {
        ClientID = strtoul(buffer, NULL, 10);
    }
    if (req.query("ClientTransactionID", buffer, sizeof(buffer)))
    {
        ClientTransactionID = strtoul(buffer, NULL, 10);
    }

    // Response values
    float Value = 0.0f;
    String ValueString = "";
    bool ValueBool = false;

    // Get thread-safe copies of data
    float sensorData[16];
    bool currentSafeState;
    int32_t currentErrorNumber;
    String currentErrorMessage;

    {
        std::lock_guard<Mutex> dataLock(s700DataMutex);
        memcpy(sensorData, s700Values, sizeof(s700Values));
    }
    {
        std::lock_guard<Mutex> safeLock(safetyStateMutex);
        currentSafeState = isSafe;
    }
    {
        std::lock_guard<Mutex> errorLock(errorStateMutex);
        currentErrorNumber = ErrorNumber;
        currentErrorMessage = ErrorMessage;
    }

    // Route endpoint requests
    if (url == "connected")
    {
        ValueBool = true;
    }
    else if (url == "name")
    {
        ValueString = "Alpaca Weather Station and Safety Monitor v0.0.4";
    }
    else if (url == "driverversion")
    {
        ValueString = "0.0.4";
    }
    else if (url == "issafe")
    {
        ValueBool = currentSafeState;
    }
    else if (url == "temperature")
    {
        Value = sensorData[s700Key.at("AT")];
    }
    else if (url == "humidity")
    {
        Value = sensorData[s700Key.at("AH")];
    }
    else if (url == "dewpoint")
    {
        Value = calculateDewPoint(sensorData[s700Key.at("AT")], sensorData[s700Key.at("AH")]);
    }
    else if (url == "pressure")
    {
        Value = sensorData[s700Key.at("AP")] / 100.0f; // Convert Pa to hPa
    }
    else if (url == "skybrightness")
    {
        Value = sensorData[s700Key.at("LX")];
    }
    else if (url == "windspeed")
    {
        Value = sensorData[s700Key.at("SA")];
    }
    else if (url == "windgust")
    {
        Value = sensorData[s700Key.at("SM")];
    }
    else if (url == "winddirection")
    {
        Value = sensorData[s700Key.at("DA")];
    }
    else if (url == "rainrate")
    {
        Value = sensorData[s700Key.at("RI")];
        if (!rainSensorSafe)
        {
            Value += 0.01f; // Add sensitivity for rain sensor
        }
    }
    else
    {
        std::lock_guard<Mutex> errorLock(errorStateMutex);
        ErrorNumber = 1;
        ErrorMessage = "\"Invalid endpoint path\"";
        currentErrorNumber = ErrorNumber;
        currentErrorMessage = ErrorMessage;
    }

    // Build JSON response
    res.print("{");
    res.print("\"ClientID\": ");
    res.print(ClientID);
    res.print(", \"ClientTransactionID\": ");
    res.print(ClientTransactionID);
    res.print(", \"ServerID\": ");
    res.print(ServerID);
    res.print(", \"ErrorNumber\": ");
    res.print(currentErrorNumber);
    res.print(", \"ErrorMessage\": ");
    res.print(currentErrorMessage);
    res.print(", \"Value\": ");

    if (url == "name" || url == "driverversion")
    {
        res.print("\"");
        res.print(ValueString);
        res.print("\"");
    }
    else if (url == "issafe" || url == "connected")
    {
        res.print(ValueBool ? "true" : "false");
    }
    else
    {
        res.print(Value);
    }
    res.print("}");

    // Reset error state only if we didn't just set a new error
    if (url != "invalid")
    {
        std::lock_guard<Mutex> errorLock(errorStateMutex);
        ErrorNumber = 0;
        ErrorMessage = "\"\"";
    }
}

