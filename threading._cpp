// Board info
OptaBoardInfo *info;
OptaBoardInfo *boardInfo();

// Configuration constants
constexpr auto BAUDRATE = 9600;
constexpr auto SENSOR_READ_INTERVAL_MS = 500;
constexpr auto DEFAULT_SAFETY_FALSE_DURATION = 10;
constexpr auto RAIN_SENSOR_THRESHOLD = 10;

// Weather safety limits structure
struct WeatherLimits
{
    float AT_min = 0.0f;                                       // Air temperature low limit (°C)
    float AT_max = 50.0f;                                      // Air temperature high limit (°C)
    float AH_min = 0.0f;                                       // Air humidity low limit (%RH)
    float AH_max = 80.0f;                                      // Air humidity high limit (%RH)
    float LX_max = 10000.0f;                                   // Light intensity high limit (Lux)
    float SM_max = 20.0f;                                      // Gust wind speed high limit (m/s)
    float SA_max = 15.0f;                                      // Average wind speed high limit (m/s)
    int safety_false_duration = DEFAULT_SAFETY_FALSE_DURATION; // Time in seconds to keep isSafe false
};

// Function declarations
String split(String data, char separator, int index);
void readSensors();
bool readWeatherStation();
bool parseS700Data(const String &data);
bool safetyCheck();
float calculateDewPoint(float temperature, float humidity);
void networkHandler();
void endPoint(Request &req, Response &res);
void index(Request &req, Response &res);
void submit(Request &req, Response &res);
int getLimits(const char *key, WeatherLimits *limits);
int setLimits(const char *key, const WeatherLimits &limits);

